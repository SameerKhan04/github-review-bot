# LLM provider (OpenAI-compatible, e.g. OpenAI or xAI/Grok)
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# GitHub App (preferred for production and multi-repo installs)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional alternative to GITHUB_APP_PRIVATE_KEY:
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=

# Local-dev fallback if GitHub App credentials are not set
GITHUB_TOKEN=

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
PORT=5000
DB_FILE=reviews.db
MAX_DIFF_CHARS=80000
FLASK_DEBUG=0
